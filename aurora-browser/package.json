{
  "name": "aurora-os",
  "productName": "Aurora OS",
  "version": "1.0.0",
  "description": "Aurora Browser - Chromium-based browser with Aurora OS integration",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "dist": "electron-builder --mac"
  },
  "build": {
    "appId": "com.aurora.os",
    "publish": {
      "provider": "github",
      "owner": "Danaemisdan",
      "repo": "Aurora-OS"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "dmg": {
      "title": "Aurora OS",
      "sign": false
    },
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!Add-Ons/**"
    ]
  },
  "keywords": [
    "browser",
    "electron",
    "aurora"
  ],
  "author": "Aurora OS",
  "license": "MIT",
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "electron-updater": "^6.8.9",
    "msedge-tts": "^2.0.6",
    "node-llama-cpp": "^3.16.0"
  }
}
